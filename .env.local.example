# === Kommo ===
KOMMO_DOMAIN=https://SUACONTA.kommo.com
# Token de LONGA DURAÇÃO: é um JWT e começa com "eyJ". A "chave secreta" de 64
# caracteres da mesma tela NÃO é token — dá 401 (kommo/PEGADINHAS.md §17).
KOMMO_TOKEN=
KOMMO_ACCOUNT_ID=
# Salesbot de ENVIO (1 bloco "Enviar mensagem" pelo canal WhatsApp Lite, lendo o
# campo "Resposta IA (agente)"). O id aparece na URL do bot no Kommo.
KOMMO_BOT_ID=

# === LLM (padrão da skill: GPT-5.4 Mini, Chat Completions, reasoning none) ===
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini-2026-03-17
VISION_MODEL=gpt-5.4-mini-2026-03-17
STT_MODEL=gpt-4o-mini-transcribe

# === Upstash Redis (OBRIGATÓRIO no Kommo: o histórico mora aqui) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Database compartilhado entre clientes: prefixo ÚNICO por cliente
REDIS_PREFIX=ak-cg-sdr:

# === Operação ===
WEBHOOK_SECRET=            # openssl rand -hex 24 — NOVO por cliente
CLIENT_NAME="Control Gestão · Lara SDR"
DEBOUNCE_SECONDS=10
# Gate: a IA põe esta tag nos leads que ELA inicia e só responde quem tem a tag.
# Ao finalizar (reunião marcada ou encerrada) a tag sai. Tire à mão para desligar.
GATE_TAG=ia-sdr
# Tag que desliga a IA quando um humano assume
HUMAN_TAG=atendimento-humano
# Contatos de teste que podem mandar "reset" (lead_ids separados por vírgula)
TEST_LEAD_IDS=

# === Só para scripts locais ===
DEPLOY_URL=

# === Indicações de parceiro Kommo ===
# Segredo que o userscript usa para avisar o agente (openssl rand -hex 24). Vai no
# CFG.AGENTE_SECRET do userscript. Diferente do WEBHOOK_SECRET.
INDICACAO_SECRET=
# Rampagem da abertura ativa: desligado | teste (só TEST_LEAD_IDS) | ligado
MODO_INICIO=teste
# inteligente = óbvio pela regra, "teste" dentro de frase maior decidido pela IA (intenção) · estrito = qualquer "teste" bloqueia
FILTRO_TESTE_MODO=inteligente
# 1 = sem "Comment:" a IA não inicia (pode não ser indicação) · 0 = inicia mesmo assim
EXIGIR_COMENTARIO=1

# === Google Agenda (opcional, só livre/ocupado) ===
# JSON da conta de serviço (texto ou base64); compartilhe a agenda do closer com o
# e-mail dela em "Ver apenas livre/ocupado".
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
